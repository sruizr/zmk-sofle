#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Layer definitions
#define COLDHM 0
#define SYM 1
#define NUM 2
#define NAV 3
#define SYS 4


&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps_lock {
            bindings = <&kp CAPS>;
            key-positions = <16 22>; // F & U positions in COLDHM
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <17 21>; // P & L positions in COLDHM
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: COLDHM (Colemak-DHm with home mods)
        coldhm_layer {
            bindings = <
&kp ESC     &kp N1       &kp N2        &kp N3         &kp N4            &kp N5          &kp UP_ARROW     &kp N6     &kp N7            &kp N8            &kp N9          &kp N0        &kp BACKSPACE
&kp TAB     &kp Q        &kp W         &kp F          &kp P             &kp B           &kp DOWN_ARROW   &kp J      &kp L             &kp U             &kp Y           &kp SEMI      &kp BSLH
&kp CAPS    &hm LGUI A   &hm LALT R    &hm LCTRL S    &hm LSHFT T       &kp G           &kp LEFT_ARROW   &kp M      &hm RSHFT N       &hm RCTRL E       &hm LALT I      &hm RGUI O    &kp APOS
&kp LSHFT   &kp Z        &kp X         &kp C          &hm RALT D        &kp V           &kp RIGHT_ARROW  &kp K      &hm RALT H        &kp COMMA         &kp DOT         &kp FSLH      &kp ENTER
&kp C_MUTE  &kp LCTRL    &kp LEFT_GUI  &lt NUM ESC    &lt NAV SPACE     &kp TAB         &kp ENTER        &kp DELETE &lt SYM ENTER     &lt SYS BACKSPACE &kp RSHFT       &kp DELETE
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "COLDHM";
        };

        // Layer 1: SYM (Symbols)
        sym_layer {
            bindings = <
&trans  &trans        &trans        &trans         &trans           &trans     &trans  &trans       &trans           &trans         &trans        &trans        &trans
&trans  &none         &kp RBKT      &kp RBRC       &kp RPAR         &kp DLLR   &trans  &kp CARET    &kp AMPS         &kp PRCNT      &kp TILDE     &none         &trans
&trans  &hm LGUI DQT  &hm LALT LBKT &hm LCTRL LBRC &hm LSHFT LPAR   &kp AT     &trans  &kp PIPE     &hm RSHFT UNDER  &hm RCTRL EQUAL &hm LALT COLON &hm RGUI MINUS &trans
&trans  &kp QMARK     &kp EXCL      &kp HASH       &hm RALT APOS    &none      &trans  &none        &hm RALT STAR    &kp PLUS       &kp BSLH      &kp GRAVE     &trans
&trans  &trans        &trans        &trans         &trans           &trans     &trans  &trans       &trans           &trans         &trans        &trans
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "SYM";
        };

        // Layer 2: NUM (Numbers and Function keys)
        num_layer {
            bindings = <
&trans  &trans       &trans       &trans        &trans        &trans        &trans  &trans     &trans        &trans        &trans        &trans        &trans
&trans  &kp F1       &kp F2       &kp F3        &kp F4        &kp PSCRN     &trans  &kp STAR   &kp N7        &kp N8        &kp N9        &kp MINUS     &trans
&trans  &hm LGUI F5  &hm LALT F6  &hm LCTRL F7  &hm LSHFT F8  &kp SLCK      &trans  &kp FSLH   &hm RSHFT N4  &hm RCTRL N5  &hm LALT N6   &hm RGUI PLUS &trans
&trans  &kp F9       &kp F10      &kp F11       &hm RALT F12  &kp PAUSE_BREAK &trans &none     &hm RALT N1   &kp N2        &kp N3        &kp DOT       &trans
&trans  &trans       &trans       &trans        &trans        &trans        &trans  &trans     &kp N0        &trans        &trans        &trans
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "NUM";
        };

        // Layer 3: NAV (Navigation and Mouse)
        nav_layer {
            bindings = <
&trans  &trans    &trans     &trans      &trans      &trans      &mmv MOVE_UP     &trans  &trans       &trans    &trans   &trans     &trans
&trans  &trans    &mkp LCLK  &mkp MCLK   &mkp RCLK   &mkp MB4    &mmv MOVE_DOWN   &none   &kp PG_UP    &kp HOME  &kp INS  &trans     &trans
&trans  &kp LGUI  &kp LALT   &kp LCTRL   &kp LSHIFT  &mkp MB5    &mmv MOVE_LEFT   &none   &kp LEFT     &kp DOWN  &kp UP   &kp RIGHT  &trans
&trans  &none     &none      &none       &kp RALT    &none       &mmv MOVE_RIGHT  &none   &kp PG_DN    &kp END   &trans   &trans     &trans
&trans  &trans    &trans     &trans      &trans      &trans      &mkp LCLK        &trans  &trans       &trans    &trans   &trans
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "NAV";
        };

        // Layer 4: SYS (System controls)
        sys_layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans     &rgb_ug RGB_ON   &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &trans           &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &trans  &trans     &rgb_ug RGB_OFF  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &trans
&trans  &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &trans  &trans     &trans           &trans           &trans           &trans           &trans
&trans  &sys_reset    &trans          &bootloader   &trans        &trans          &trans  &trans     &soft_off        &bootloader      &trans           &sys_reset       &trans
&trans  &trans        &trans          &trans        &trans        &trans          &trans  &trans     &trans           &trans           &trans           &trans
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "SYS";
        };
    };
};
